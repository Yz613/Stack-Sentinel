{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stack-sentinel",
  "compatibility_date": "2026-11-20",
  "main": "src/worker.ts",
  "triggers": {
    "crons": [
      "0 14 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stack-sentinel-db"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
